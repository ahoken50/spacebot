# Copiez ce fichier vers .env puis renseignez les valeurs localement.
# .env est ignoré par Git et ne doit jamais être versé au dépôt.

OPENROUTER_API_KEY=remplacer_par_votre_cle_openrouter

# Mot de passe local du magasin Postgres + pgvector. Utilisez une valeur forte et unique.
PROJECT_HUB_MEMORY_DB_PASSWORD=remplacer_par_un_mot_de_passe_fort

# Modèle d'embeddings OpenRouter utilisé seulement pour les mémoires et documents nouveaux/modifiés.
# La dimension doit correspondre à PROJECT_HUB_EMBEDDING_DIMENSIONS et ne doit pas changer après initialisation.
PROJECT_HUB_EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b
PROJECT_HUB_EMBEDDING_DIMENSIONS=1024

# Boucle DSPy supervisée : ne traite que des cas de référence approuvés et dépersonnalisés.
# Le plafond par défaut limite une exécution à deux cas, un candidat et huit appels de modèle au plus.
PROJECT_HUB_OPTIMIZER_MODEL=openrouter/qwen/qwen3.7-flash
PROJECT_HUB_OPTIMIZER_MAX_CASES=2
PROJECT_HUB_OPTIMIZER_MAX_CANDIDATES=1
PROJECT_HUB_OPTIMIZER_MAX_CALLS=8

# Boucle SkillOpt : apprend uniquement des fichiers SKILL.md autorisés à partir d’un pack
# approuvé, dépersonnalisé et partitionné. Elle produit des propositions, jamais une promotion directe.
PROJECT_HUB_SKILLOPT_ENABLED=true
PROJECT_HUB_SKILLOPT_AUTONOMOUS_ENABLED=true
PROJECT_HUB_SKILLOPT_INTERVAL_HOURS=24
PROJECT_HUB_SKILLOPT_MAX_TRAIN_CASES=2
PROJECT_HUB_SKILLOPT_MAX_VALIDATION_CASES=2
PROJECT_HUB_SKILLOPT_MAX_HOLDOUT_CASES=2
PROJECT_HUB_SKILLOPT_MAX_EPOCHS=1
PROJECT_HUB_SKILLOPT_MAX_STEPS=1
PROJECT_HUB_SKILLOPT_MAX_COMPLETION_TOKENS=650
PROJECT_HUB_SKILLOPT_MAX_RUNS_PER_DAY=1
PROJECT_HUB_SKILLOPT_TIMEOUT_SECONDS=600
PROJECT_HUB_SKILLOPT_OPTIMIZER_MODEL=qwen/qwen3.7-flash
PROJECT_HUB_SKILLOPT_TARGET_MODEL=qwen/qwen3.7-flash

# Jeton interne unique : autorise seulement le mineur local à lire les enregistrements explicitement
# marqués completed=true et learning_eligible=true. Générez une valeur aléatoire locale.
PROJECT_HUB_MEMORY_EXPORT_TOKEN=remplacer_par_un_jeton_aleatoire_long

# Mineur local de cas de référence : produit des fichiers candidates séparés des packs DSPy/SkillOpt.
# Il ne déclenche aucun appel LLM et ne promeut jamais automatiquement un candidat.
PROJECT_HUB_REFERENCE_MINER_ENABLED=true
PROJECT_HUB_REFERENCE_MINER_AUTONOMOUS_ENABLED=true
PROJECT_HUB_REFERENCE_MINER_CYCLE_HOURS=24
PROJECT_HUB_REFERENCE_MINER_MAX_CANDIDATES=3
PROJECT_HUB_REFERENCE_MINER_MAX_RUNS_PER_DAY=1

# Jeton interne distinct pour les déclenchements entre le mineur, DSPy et SkillOpt.
# Générez une valeur aléatoire longue et ne la partagez pas hors de la machine locale.
PROJECT_HUB_AUTONOMOUS_PIPELINE_TOKEN=remplacer_par_un_second_jeton_aleatoire_long

# Chaîne autonome : découverte, préparation des packs, évaluations DSPy/SkillOpt et propositions.
# Elle ne peut jamais promouvoir une instruction ou une compétence en production.
PROJECT_HUB_AUTONOMOUS_PIPELINE_ENABLED=true

# Pont vers le tableau de tâches Spacebot : création automatique des demandes d’approbation.
# Ce jeton protège seulement le déclenchement interne du pont; l’approbation reste faite dans l’interface Web.
PROJECT_HUB_APPROVAL_BRIDGE_TOKEN=remplacer_par_un_troisieme_jeton_aleatoire_long
PROJECT_HUB_APPROVAL_BRIDGE_ENABLED=true
PROJECT_HUB_APPROVAL_BRIDGE_INTERVAL_SECONDS=60

# Boucle de remédiation des échecs : lit seulement les tâches Spacebot échouées et leurs tentatives
# durables. Elle crée une leçon diagnostique toujours bloquée jusqu’à Approve; toute recherche de capacité suit ensuite son flux distinct d’approbation.
PROJECT_HUB_FAILURE_REMEDIATOR_TOKEN=remplacer_par_un_quatrieme_jeton_aleatoire_long
PROJECT_HUB_FAILURE_REMEDIATOR_ENABLED=true
PROJECT_HUB_FAILURE_REMEDIATOR_INTERVAL_SECONDS=120
PROJECT_HUB_FAILURE_REMEDIATOR_MAX_PROPOSALS_PER_DAY=3

# Veille municipale officielle : collecte déterministe de sources explicitement approuvées.
# Un changement crée une fiche d’examen dans Spacebot; aucune conclusion juridique, application, transmission ou soumission n’est automatique.
PROJECT_HUB_MUNICIPAL_WATCH_ENABLED=true
PROJECT_HUB_MUNICIPAL_WATCH_INTERVAL_SECONDS=86400
PROJECT_HUB_MUNICIPAL_WATCH_MAX_SOURCES=12
PROJECT_HUB_MUNICIPAL_WATCH_TOKEN=remplacer_par_un_cinquieme_jeton_aleatoire_long
