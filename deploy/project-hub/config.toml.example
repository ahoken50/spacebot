# Instance locale Docker générique pour le pilotage de projets municipaux ou de recherche.
# Définir OPENROUTER_API_KEY dans .env. Aucun modèle Claude n’est configuré.

[llm]
openrouter_key = "env:OPENROUTER_API_KEY"

[defaults]
max_concurrent_branches = 1
max_concurrent_workers = 1
max_turns = 3
branch_max_turns = 6
context_window = 96000
history_backfill_count = 12
worker_log_mode = "errors_only"
# Adapter ces fuseaux au territoire du projet.
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[defaults.routing]
channel = "openrouter/deepseek/deepseek-v4-flash"
branch = "openrouter/openai/gpt-oss-120b"
worker = "openrouter/qwen/qwen3.7-flash"
compactor = "openrouter/mistralai/mistral-nemo"
cortex = "openrouter/mistralai/mistral-nemo"
rate_limit_cooldown_secs = 90

[defaults.routing.task_overrides]
document_vision = "openrouter/google/gemini-2.5-flash-lite"
deep_reasoning = "openrouter/openai/gpt-oss-120b"
structured_extraction = "openrouter/qwen/qwen3.7-flash"
data_processing = "openrouter/qwen/qwen3.7-flash"
coding = "openrouter/openai/gpt-oss-120b"

[defaults.routing.fallbacks]
"openrouter/deepseek/deepseek-v4-flash" = ["openrouter/openai/gpt-oss-120b", "openrouter/google/gemini-2.5-flash-lite"]
"openrouter/openai/gpt-oss-120b" = ["openrouter/deepseek/deepseek-v4-flash", "openrouter/google/gemini-2.5-flash-lite"]
"openrouter/qwen/qwen3.7-flash" = ["openrouter/deepseek/deepseek-v4-flash", "openrouter/openai/gpt-oss-120b"]
"openrouter/mistralai/mistral-nemo" = ["openrouter/qwen/qwen3.7-flash"]
"openrouter/google/gemini-2.5-flash-lite" = ["openrouter/deepseek/deepseek-v4-flash"]

[defaults.opencode]
enabled = true
path = "/root/.bun/bin/opencode"
max_servers = 1
server_startup_timeout_secs = 45
max_restart_retries = 2

[defaults.opencode.permissions]
edit = "allow"
bash = "allow"
webfetch = "deny"

[defaults.compaction]
mode = "chronicle"
background_threshold = 0.72
aggressive_threshold = 0.82
emergency_threshold = 0.93

[defaults.compaction.chronicle]
interval_messages = 24
interval_token_fraction = 0.08
recent_window_hours = 24
max_recent = 4
max_older = 6
context_token_budget = 1200
expand_message_limit = 25
max_messages_per_checkpoint = 120
rollup_threshold = 8
rollup_batch = 4

[defaults.memory_persistence]
enabled = false
message_interval = 100

[defaults.skills.reflection]
enabled = false
min_tool_iterations = 20
cooldown_secs = 14400

[defaults.cortex]
tick_interval_secs = 900
worker_wall_clock_timeout_secs = 600
circuit_breaker_threshold = 3

# Toute décision financière, réglementaire, institutionnelle ou publication externe reste humaine.
[defaults.autonomy]
level = "suggest"
interval_secs = 14400
max_turns = 4
max_tasks_per_run = 1
timeout_secs = 600
warn_secs = 480
run_history_count = 3
claim_unowned = false

[defaults.browser]
enabled = false
headless = true
evaluate_enabled = false
persist_session = false
close_policy = "close_tabs"

[[defaults.mcp]]
name = "project_shared_memory"
transport = "http"
url = "http://project-shared-memory:3010/mcp"

[[humans]]
id = "project-sponsor"
display_name = "Responsable municipal désigné"
role = "Autorité d’approbation des orientations, engagements, livrables officiels, communications externes et changements durables."
bio = "Valide les décisions sensibles, les livrables externes, les changements de budget, d’échéancier, de capacité et toute diffusion officielle."

[[agents]]
id = "project-coordination"
display_name = "Coordonnateur municipal de projets"
role = "Point d’entrée Web du coordonnateur en environnement : qualification, planification, délégation, consolidation et demande d’approbation pour tout projet municipal."
default = true
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[agents.browser]
enabled = true
headless = true
evaluate_enabled = false
persist_session = false
close_policy = "close_tabs"

[[agents.mcp]]
