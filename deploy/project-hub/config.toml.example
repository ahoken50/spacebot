# Instance locale Docker d’assistance adaptative aux tâches.
# Définir OPENROUTER_API_KEY dans .env. Aucun modèle Claude n’est configuré.

[llm]
openrouter_key = "env:OPENROUTER_API_KEY"

[defaults]
max_concurrent_branches = 2
max_concurrent_workers = 3
max_turns = 6
branch_max_turns = 10
context_window = 96000
history_backfill_count = 12
worker_log_mode = "errors_only"
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[defaults.routing]
channel = "openrouter/deepseek/deepseek-v4-flash"
branch = "openrouter/openai/gpt-oss-120b"
worker = "openrouter/qwen/qwen3.7-flash"
compactor = "openrouter/mistralai/mistral-nemo"
cortex = "openrouter/mistralai/mistral-nemo"
rate_limit_cooldown_secs = 90

[defaults.routing.task_overrides]
document_vision = "openrouter/google/gemini-2.5-flash-lite"
deep_reasoning = "openrouter/openai/gpt-oss-120b"
structured_extraction = "openrouter/qwen/qwen3.7-flash"
data_processing = "openrouter/qwen/qwen3.7-flash"
coding = "openrouter/openai/gpt-oss-120b"

[defaults.routing.fallbacks]
"openrouter/deepseek/deepseek-v4-flash" = ["openrouter/openai/gpt-oss-120b", "openrouter/google/gemini-2.5-flash-lite"]
"openrouter/openai/gpt-oss-120b" = ["openrouter/deepseek/deepseek-v4-flash", "openrouter/google/gemini-2.5-flash-lite"]
"openrouter/qwen/qwen3.7-flash" = ["openrouter/deepseek/deepseek-v4-flash", "openrouter/openai/gpt-oss-120b"]
"openrouter/mistralai/mistral-nemo" = ["openrouter/qwen/qwen3.7-flash"]
"openrouter/google/gemini-2.5-flash-lite" = ["openrouter/deepseek/deepseek-v4-flash"]

[defaults.opencode]
enabled = true
path = "/root/.bun/bin/opencode"
max_servers = 2
server_startup_timeout_secs = 45
max_restart_retries = 2

[defaults.opencode.permissions]
edit = "allow"
bash = "allow"
webfetch = "deny"

[defaults.compaction]
mode = "chronicle"
background_threshold = 0.72
aggressive_threshold = 0.82
emergency_threshold = 0.93

[defaults.compaction.chronicle]
interval_messages = 24
interval_token_fraction = 0.08
recent_window_hours = 24
max_recent = 4
max_older = 6
context_token_budget = 1200
expand_message_limit = 25
max_messages_per_checkpoint = 120
rollup_threshold = 8
rollup_batch = 4

[defaults.memory_persistence]
enabled = false
message_interval = 100

[defaults.skills.reflection]
enabled = true
min_tool_iterations = 8
cooldown_secs = 3600

[defaults.cortex]
tick_interval_secs = 300
worker_wall_clock_timeout_secs = 900
circuit_breaker_threshold = 3

# Niveau maximal pris en charge par Spacebot : les tâches ready peuvent être exécutées,
# les tâches pending_approval sont enrichies et les suites de travail sont proposées.
[defaults.autonomy]
level = "act"
interval_secs = 900
max_turns = 12
max_tasks_per_run = 2
timeout_secs = 720
warn_secs = 600
run_history_count = 6
claim_unowned = true

[defaults.browser]
enabled = false
headless = true
evaluate_enabled = false
persist_session = false
close_policy = "close_tabs"

[[defaults.mcp]]
name = "project_shared_memory"
transport = "http"
url = "http://project-shared-memory:3010/mcp"

[[humans]]
id = "task-owner"
display_name = "Responsable de l’espace de travail"
role = "Définit les priorités, approuve les tâches sensibles, les changements durables et toute communication ou publication externe."
bio = "Conserve la décision finale sur les engagements, accès, dépenses, transmissions, changements de configuration et promotion d’apprentissages."

[[agents]]
id = "task-orchestrator"
display_name = "Orchestrateur adaptatif"
role = "Point d’entrée : comprend la demande, produit un plan vérifiable, sélectionne les expertises utiles, délègue, consolide, évalue le résultat et crée les prochaines tâches nécessaires."
default = true
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[agents.browser]
enabled = true
headless = true
evaluate_enabled = false
persist_session = false
close_policy = "close_tabs"

[[agents.mcp]]
name = "project_document_studio"
transport = "http"
url = "http://project-document-studio:3012/mcp"

[[agents.mcp]]
name = "project_supervised_optimizer"
transport = "http"
url = "http://project-optimizer:3013/mcp"

[[agents.mcp]]
name = "project_skillopt"
transport = "http"
url = "http://project-skillopt:3014/mcp"

[[agents.mcp]]
name = "project_reference_miner"
transport = "http"
url = "http://project-reference-miner:3015/mcp"

[[agents]]
id = "task-research"
display_name = "Chercheur et analyste de sources"
role = "Recherche des sources fiables, extrait les faits, compare les options, qualifie les incertitudes et produit un dossier de preuves réutilisable."
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[agents.browser]
enabled = true
