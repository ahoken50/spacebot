# Instance locale Docker dédiée au pilotage de la convention COV_OASIS-V2.
# La clé OpenRouter est fournie au conteneur avec OPENROUTER_API_KEY dans .env.
# Aucun modèle Claude n’est configuré.

[llm]
openrouter_key = "env:OPENROUTER_API_KEY"

[defaults]
# Sobriété : limiter les fan-outs et le contexte brut, sans sacrifier les livrables complexes.
max_concurrent_branches = 1
max_concurrent_workers = 1
max_turns = 3
branch_max_turns = 6
context_window = 96000
history_backfill_count = 12
worker_log_mode = "errors_only"
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[defaults.routing]
channel = "openrouter/deepseek/deepseek-v4-flash"
branch = "openrouter/openai/gpt-oss-120b"
worker = "openrouter/qwen/qwen3.7-flash"
compactor = "openrouter/mistralai/mistral-nemo"
cortex = "openrouter/mistralai/mistral-nemo"
rate_limit_cooldown_secs = 90

[defaults.routing.task_overrides]
document_vision = "openrouter/google/gemini-2.5-flash-lite"
deep_reasoning = "openrouter/openai/gpt-oss-120b"
structured_extraction = "openrouter/qwen/qwen3.7-flash"
data_processing = "openrouter/qwen/qwen3.7-flash"
coding = "openrouter/openai/gpt-oss-120b"

[defaults.routing.fallbacks]
"openrouter/deepseek/deepseek-v4-flash" = ["openrouter/openai/gpt-oss-120b", "openrouter/google/gemini-2.5-flash-lite"]
"openrouter/openai/gpt-oss-120b" = ["openrouter/deepseek/deepseek-v4-flash", "openrouter/google/gemini-2.5-flash-lite"]
"openrouter/qwen/qwen3.7-flash" = ["openrouter/deepseek/deepseek-v4-flash", "openrouter/openai/gpt-oss-120b"]
"openrouter/mistralai/mistral-nemo" = ["openrouter/qwen/qwen3.7-flash"]
"openrouter/google/gemini-2.5-flash-lite" = ["openrouter/deepseek/deepseek-v4-flash"]

# OpenCode est réservé aux tâches de développement multi-fichiers. Les agents builtin
# restent utilisés pour l’analyse documentaire, SIG, commandes ponctuelles et écritures courtes.
[defaults.opencode]
enabled = true
path = "/root/.bun/bin/opencode"
max_servers = 1
server_startup_timeout_secs = 45
max_restart_retries = 2

[defaults.opencode.permissions]
edit = "allow"
bash = "allow"
webfetch = "deny"

# Chronicle évite de renvoyer des transcriptions longues; le budget injecté est volontairement borné.
[defaults.compaction]
mode = "chronicle"
background_threshold = 0.72
aggressive_threshold = 0.82
emergency_threshold = 0.93

[defaults.compaction.chronicle]
interval_messages = 24
interval_token_fraction = 0.08
recent_window_hours = 24
max_recent = 4
max_older = 6
context_token_budget = 1200
expand_message_limit = 25
max_messages_per_checkpoint = 120
rollup_threshold = 8
rollup_batch = 4

# Éviter des branches silencieuses de mémoire/réflexion; la mémoire SQL commune est alimentée
# explicitement seulement par des faits, décisions et livrables vérifiables.
[defaults.memory_persistence]
enabled = false
message_interval = 100

[defaults.skills.reflection]
enabled = false
min_tool_iterations = 20
cooldown_secs = 14400

[defaults.cortex]
tick_interval_secs = 900
worker_wall_clock_timeout_secs = 600
circuit_breaker_threshold = 3

# Une action contractuelle, financière ou une transmission au Ministère nécessite une approbation humaine.
[defaults.autonomy]
level = "suggest"
interval_secs = 14400
max_turns = 4
max_tasks_per_run = 1
timeout_secs = 600
warn_secs = 480
run_history_count = 3
claim_unowned = false

# Le navigateur ajoute beaucoup d’outils et de contexte : il est réservé au coordonnateur.
[defaults.browser]
enabled = false
headless = true
evaluate_enabled = false
persist_session = false
close_policy = "close_tabs"

# Chaque agent reçoit ces outils MCP à son démarrage de travail. Ils opèrent sur le même
# PostgreSQL + pgvector et sont le registre interagent faisant autorité pour les décisions,
# données factuelles, livrables et pistes d’audit.
[[defaults.mcp]]
name = "oasis_shared_memory"
transport = "http"
url = "http://oasis-shared-memory:3010/mcp"

[[humans]]
id = "administration-vdo"
display_name = "Administration Ville de Val-d'Or"
role = "Autorité d’approbation du projet OASIS-V2"
bio = "Approuve toute soumission ministérielle, modification de budget, modification d’échéancier et engagement financier."

[[agents]]
id = "oasis-coordination"
display_name = "Coordonnateur OASIS-V2"
role = "Point d’entrée Web, planification, délégation, consolidation et demande d’approbation."
default = true
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[agents.browser]
enabled = true
headless = true
evaluate_enabled = false
persist_session = false
close_policy = "close_tabs"

[[agents.mcp]]
name = "oasis_document_studio"
transport = "http"
url = "http://oasis-document-studio:3012/mcp"

# L’optimisation est centralisée : elle ne peut produire que des propositions à approuver.
[[agents.mcp]]
name = "oasis_supervised_optimizer"
transport = "http"
url = "http://oasis-optimizer:3013/mcp"

# SkillOpt apprend uniquement des compétences ciblées sur cas approuvés; il ne promeut jamais une version seul.
[[agents.mcp]]
name = "oasis_skillopt"
transport = "http"
url = "http://oasis-skillopt:3014/mcp"

# Le mineur propose seulement des candidats dépersonnalisés; il ne modifie aucun pack actif.
[[agents.mcp]]
name = "oasis_reference_miner"
transport = "http"
url = "http://oasis-reference-miner:3015/mcp"

[[agents]]
id = "oasis-finances"
display_name = "Analyste financier OASIS-V2"
role = "Suivi du budget, dépenses, salaires, contrats, appels d’offres, admissibilité et rapprochements."
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[[agents.mcp]]
name = "oasis_document_studio"
transport = "http"
url = "http://oasis-document-studio:3012/mcp"

[[agents]]
id = "oasis-calendrier"
display_name = "Planificateur OASIS-V2"
role = "Calendrier compressé, Gantt, jalons contractuels, dépendances et contrôle des écarts."
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[[agents.mcp]]
name = "oasis_document_studio"
transport = "http"
url = "http://oasis-document-studio:3012/mcp"

[[agents]]
id = "oasis-pse-sig"
display_name = "Analyste PSE et SIG OASIS-V2"
role = "Plan de suivi et d’évaluation, KML, superficies, indicateurs, vulnérabilité et validation méthodologique."
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[[agents.mcp]]
name = "oasis_gis_local"
transport = "http"
url = "http://oasis-gis:3011/mcp"

[[agents.mcp]]
name = "oasis_document_studio"
transport = "http"
url = "http://oasis-document-studio:3012/mcp"

[[agents]]
id = "oasis-reddition"
display_name = "Rédacteur de reddition OASIS-V2"
role = "Rapports d’étape, rapport final, liste des annexes, conformité des livrables et contrôle de qualité rédactionnel."
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[[agents.mcp]]
name = "oasis_document_studio"
transport = "http"
url = "http://oasis-document-studio:3012/mcp"

[[agents]]
id = "oasis-gouvernance"
display_name = "Secrétaire du comité de suivi OASIS-V2"
role = "Comité de suivi, convocations, ordres du jour, procès-verbaux, décisions, responsables, risques et relances."
cron_timezone = "America/Toronto"
user_timezone = "America/Toronto"

[agents.sandbox]
writable_paths = ["/data/shared-workspace"]

[[agents.mcp]]
name = "oasis_document_studio"
transport = "http"
url = "http://oasis-document-studio:3012/mcp"

# Organisation : l’administration pilote le coordonnateur, qui délègue les analyses spécialisées.
[[links]]
from = "administration-vdo"
to = "oasis-coordination"
direction = "two_way"
kind = "hierarchical"

[[links]]
from = "oasis-coordination"
to = "oasis-finances"
direction = "two_way"
kind = "hierarchical"

[[links]]
from = "oasis-coordination"
to = "oasis-calendrier"
direction = "two_way"
kind = "hierarchical"

[[links]]
from = "oasis-coordination"
to = "oasis-pse-sig"
direction = "two_way"
kind = "hierarchical"

[[links]]
from = "oasis-coordination"
to = "oasis-reddition"
direction = "two_way"
kind = "hierarchical"

[[links]]
from = "oasis-coordination"
to = "oasis-gouvernance"
direction = "two_way"
kind = "hierarchical"

# Liaisons de pair à pair nécessaires lorsque les livrables se recoupent.
[[links]]
from = "oasis-finances"
to = "oasis-reddition"
direction = "two_way"
kind = "peer"

[[links]]
from = "oasis-pse-sig"
to = "oasis-reddition"
direction = "two_way"
kind = "peer"

[[links]]
from = "oasis-calendrier"
to = "oasis-gouvernance"
direction = "two_way"
kind = "peer"

[[groups]]
name = "Pilotage de la convention"
agent_ids = ["oasis-coordination", "oasis-finances", "oasis-calendrier", "oasis-pse-sig", "oasis-reddition", "oasis-gouvernance"]
color = "#0F766E"
