# Copiez ce fichier vers .env puis renseignez les valeurs localement.
# .env est ignoré par Git et ne doit jamais être versé au dépôt.

OPENROUTER_API_KEY=remplacer_par_votre_cle_openrouter

# Mot de passe local du magasin Postgres + pgvector. Utilisez une valeur forte et unique.
OASIS_MEMORY_DB_PASSWORD=remplacer_par_un_mot_de_passe_fort

# Modèle d'embeddings OpenRouter utilisé seulement pour les mémoires et documents nouveaux/modifiés.
# La dimension doit correspondre à OASIS_EMBEDDING_DIMENSIONS et ne doit pas changer après initialisation.
OASIS_EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b
OASIS_EMBEDDING_DIMENSIONS=1024

# Boucle DSPy supervisée : ne traite que des cas de référence approuvés et dépersonnalisés.
# Le plafond par défaut limite une exécution à deux cas, un candidat et huit appels de modèle au plus.
OASIS_OPTIMIZER_MODEL=openrouter/qwen/qwen3.7-flash
OASIS_OPTIMIZER_MAX_CASES=2
OASIS_OPTIMIZER_MAX_CANDIDATES=1
OASIS_OPTIMIZER_MAX_CALLS=8

# Boucle SkillOpt : apprend uniquement des fichiers SKILL.md autorisés à partir d’un pack
# approuvé, dépersonnalisé et partitionné. Elle produit des propositions, jamais une promotion directe.
OASIS_SKILLOPT_ENABLED=true
OASIS_SKILLOPT_AUTONOMOUS_ENABLED=true
OASIS_SKILLOPT_INTERVAL_HOURS=24
OASIS_SKILLOPT_MAX_TRAIN_CASES=2
OASIS_SKILLOPT_MAX_VALIDATION_CASES=2
OASIS_SKILLOPT_MAX_HOLDOUT_CASES=2
OASIS_SKILLOPT_MAX_EPOCHS=1
OASIS_SKILLOPT_MAX_STEPS=1
OASIS_SKILLOPT_MAX_COMPLETION_TOKENS=650
OASIS_SKILLOPT_MAX_RUNS_PER_DAY=1
OASIS_SKILLOPT_TIMEOUT_SECONDS=600
OASIS_SKILLOPT_OPTIMIZER_MODEL=qwen/qwen3.7-flash
OASIS_SKILLOPT_TARGET_MODEL=qwen/qwen3.7-flash

# Jeton interne unique : autorise seulement le mineur local à lire les enregistrements explicitement
# marqués completed=true et learning_eligible=true. Générez une valeur aléatoire locale.
OASIS_MEMORY_EXPORT_TOKEN=remplacer_par_un_jeton_aleatoire_long

# Mineur local de cas de référence : produit des fichiers candidates séparés des packs DSPy/SkillOpt.
# Il ne déclenche aucun appel LLM et ne promeut jamais automatiquement un candidat.
OASIS_REFERENCE_MINER_ENABLED=true
OASIS_REFERENCE_MINER_AUTONOMOUS_ENABLED=true
OASIS_REFERENCE_MINER_CYCLE_HOURS=24
OASIS_REFERENCE_MINER_MAX_CANDIDATES=3
OASIS_REFERENCE_MINER_MAX_RUNS_PER_DAY=1

# Jeton interne distinct pour les déclenchements entre le mineur, DSPy et SkillOpt.
# Générez une valeur aléatoire longue et ne la partagez pas hors de la machine locale.
OASIS_AUTONOMOUS_PIPELINE_TOKEN=remplacer_par_un_second_jeton_aleatoire_long

# Chaîne autonome : découverte, préparation des packs, évaluations DSPy/SkillOpt et propositions.
# Elle ne peut jamais promouvoir une instruction ou une compétence en production.
OASIS_AUTONOMOUS_PIPELINE_ENABLED=true

# Pont vers le tableau de tâches Spacebot : création automatique des demandes d’approbation.
# Ce jeton protège seulement le déclenchement interne du pont; l’approbation reste faite dans l’interface Web.
OASIS_APPROVAL_BRIDGE_TOKEN=remplacer_par_un_troisieme_jeton_aleatoire_long
OASIS_APPROVAL_BRIDGE_ENABLED=true
OASIS_APPROVAL_BRIDGE_INTERVAL_SECONDS=60
